# OR-12 — every variable Sound Check reads. Copy to .env.local and fill in.
# The whole flow runs with none of these set: see DEMO_MODE below.

# ---------------------------------------------------------------------------
# Demo mode (OR-13)
# ---------------------------------------------------------------------------
# true  -> replays the recorded session in fixtures/ and serves the pre-baked
#          track. No microphone, no API keys, no network. This is how the demo
#          is presented, and how a reviewer should run it first.
# false -> live voice agent and live music generation. Needs the keys below.
DEMO_MODE=true

# How long the fake "generating" state is held, so the UI state is visible.
DEMO_GENERATION_DELAY_MS=2600

# Serve the pre-baked track while leaving the live voice agent running.
# This is how the demo is presented: live intake, pre-baked audio.
PREBAKED_TRACK=true

# ---------------------------------------------------------------------------
# Voice intake — ElevenLabs Conversational AI (MR-2, OR-1, OR-2)
# ---------------------------------------------------------------------------
# Create the agent with: npm run agent:create
ELEVENLABS_API_KEY=
# Printed by npm run agent:create. NEXT_PUBLIC_ so the browser widget can use it.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Optional: a specific voice for the agent. Falls back to the account default.
ELEVENLABS_VOICE_ID=
# Optional: which LLM drives the agent.
ELEVENLABS_AGENT_LLM=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Music generation — fal.ai (MR-1)
# ---------------------------------------------------------------------------
FAL_KEY=
# Lyria 3 Pro. Kept in the environment because model catalogues move.
FAL_MUSIC_MODEL=fal-ai/lyria3/pro
FAL_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# The paid door — Whop embedded checkout, test mode
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHOP_PLAN_ID=
NEXT_PUBLIC_WHOP_TEST_MODE=true
NEXT_PUBLIC_DEMO_PRICE=49  # dollars, numeric — the $ is added in the UI
WHOP_API_KEY=

# ---------------------------------------------------------------------------
# The free door — where "Book the Jam Sesh" points
# ---------------------------------------------------------------------------
NEXT_PUBLIC_JAM_SESH_URL=https://businessbangerz.com

# ---------------------------------------------------------------------------
# Persistence — documented, deliberately not wired. See README section 3.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cost reporting (OR-10). List prices at build time; correct them here rather
# than in code when a vendor moves.
# ---------------------------------------------------------------------------
COST_VOICE_PER_MINUTE=0.12
COST_MUSIC_PER_TRACK=0.08
COST_HOSTING_PER_SESSION=0.002
FOUNDER_HOURLY_RATE=250
